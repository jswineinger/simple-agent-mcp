[Unit]
Description=MCP Lab Chatbot
After=network.target

[Service]
Type=simple
User=mcpsvc
WorkingDirectory=/home/mcpsvc/mcp-lab/chatbot
EnvironmentFile=/home/mcpsvc/mcp-lab/chatbot/chatbot.env
ExecStart=/home/mcpsvc/mcp-lab/chatbot/venv/bin/python3 app.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
