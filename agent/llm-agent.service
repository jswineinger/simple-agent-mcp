# Template — __INSTALL_USER__/__INSTALL_HOME__ are substituted by
# setup-agent-vm.sh at install time (sed, before copying to
# /etc/systemd/system/). Don't `cp` this file directly; run the script.
[Unit]
Description=MCP Lab Agent
After=network.target

[Service]
Type=simple
User=__INSTALL_USER__
WorkingDirectory=__INSTALL_HOME__/mcp-lab/agent
EnvironmentFile=__INSTALL_HOME__/mcp-lab/agent/agent.env
ExecStart=__INSTALL_HOME__/mcp-lab/agent/venv/bin/python3 app.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
