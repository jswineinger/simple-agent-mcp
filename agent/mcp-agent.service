[Unit]
Description=MCP Lab Agent
After=network.target

[Service]
Type=simple
User=labadmin
WorkingDirectory=/home/labadmin/mcp-lab/agent
EnvironmentFile=/home/labadmin/mcp-lab/agent/agent.env
ExecStart=/home/labadmin/mcp-lab/agent/venv/bin/python3 app.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
