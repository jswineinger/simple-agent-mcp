# agent.env — copy to agent.env and fill in values
# agent.env is gitignored; this example file is committed.

# ── Topology ──────────────────────────────────────────────────────────────
# Where the other two components live. Defaults assume everything (agent,
# mcp-server, Ollama) runs on one box. Splitting onto separate VMs is just
# replacing 127.0.0.1 with the real IP below — AND making the matching edit
# in mcp-server/mcp-server.env on the mcp-server host (it declares the same
# three variables so both files show the full topology at a glance).
AGENT_IP=127.0.0.1        # this box's own address — informational only,
                          # not read by app.py
MCPSERVER_IP=127.0.0.1
MCP_SERVER_PORT=8765      # must match MCP_SERVER_PORT in mcp-server.env
OLLAMA_URL=http://127.0.0.1:11434

# ── LLM endpoints ─────────────────────────────────────────────────────────
# PRIVATE_LLM_URL is derived from OLLAMA_URL above (+ "/v1") — not set here.
PUBLIC_LLM_URL=https://api.anthropic.com/v1
FAIG_URL=https://<FAIG_HOSTNAME>:30443/v1

# ── Models ────────────────────────────────────────────────────────────────
PRIVATE_MODEL=qwen2.5:14b
PUBLIC_MODEL=claude-sonnet-4-6

# ── Auth ──────────────────────────────────────────────────────────────────
# Bearer token for Ollama and FortiAIGate
API_KEY=ollama
# Anthropic API key (required for Direct + Public mode)
ANTHROPIC_API_KEY=sk-ant-

# ── FortiAIGate API Key Validation ────────────────────────────────────────
# Sent only on FAIG-mode requests. Must match a key on FAIG's
# Settings > API Keys page when API Key Validation is enabled on the AI Flow.
# FAIG_VALIDATION_HEADER must match the flow's "Custom Authentication Header"
# (FAIG default: Authorization → sent as "Bearer <key>"; any other header is
# sent as the raw key value).
FAIG_VALIDATION_ENABLED=true
FAIG_VALIDATION_KEY=123456
FAIG_VALIDATION_HEADER=Authorization

# ── TLS ───────────────────────────────────────────────────────────────────
# Set to true only if FortiAIGate has a trusted cert
VERIFY_TLS=false

# ── App ───────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── MCP server — JSON-RPC 2.0 over HTTP ──────────────────────────────────
# MCP_SERVER_URL is derived from MCPSERVER_IP + MCP_SERVER_PORT above — not
# set here.
# Bearer token — must match MCP_AUTH_TOKEN in mcp-server/mcp-server.env on
# the mcp-server host. Required; without it every tool call is rejected (401).
MCP_AUTH_TOKEN=changeme-generate-a-real-token

# ── Public MCP server (dlptest — external, Streamable HTTP) ────────────────
# Real JSON-RPC 2.0 MCP over HTTPS. Public/unauthenticated DLP test server.
# Tools are exposed to the model as dlptest__<toolname> in ALL four modes.
# Note: the JSON-RPC endpoint lives on mcp.dlptest.com, not dlptest.com —
# https://dlptest.com/mcp/ is documentation only.
DLPTEST_MCP_URL=https://mcp.dlptest.com/api/mcp/
DLPTEST_ENABLED=true
MCP_HTTP_TIMEOUT=30
