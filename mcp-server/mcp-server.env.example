# mcp-server.env — copy to mcp-server.env and fill in values
# mcp-server.env is gitignored; this example file is committed.

# ── Topology ─────────────────────────────────────────────────────────────
# Where the other two components live. Defaults assume everything (agent,
# mcp-server, Ollama) runs on one box. Neither var below is read by
# mcp_server.py — they're declared here purely so this file shows the same
# 3-host topology as agent/agent.env.example. The actual bind address is
# MCP_SERVER_HOST below; the actual Ollama connection is OLLAMA_URL below.
AGENT_IP=127.0.0.1
MCPSERVER_IP=127.0.0.1

# ── Network ───────────────────────────────────────────────────────────────
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8765

# ── Auth ──────────────────────────────────────────────────────────────────
# Shared bearer token the agent must present as "Authorization: Bearer <token>"
# on every request. Required — the server refuses to start without one
# (fail closed; see mcp_server.py's __main__). Generate a real value with:
#   openssl rand -hex 32
# This same value must be copied into MCP_AUTH_TOKEN in agent/agent.env
# on the agent VM.
MCP_AUTH_TOKEN=changeme-generate-a-real-token

# ── Ollama ────────────────────────────────────────────────────────────────
# Where list_ollama_models queries Ollama's REST API (GET /api/tags). This
# server no longer needs to run on the same host as Ollama.
OLLAMA_URL=http://127.0.0.1:11434
