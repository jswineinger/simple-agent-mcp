[Unit]
Description=MCP Server (mcp-lab)
After=network.target ollama.service
Wants=ollama.service

[Service]
Type=simple
User=labadmin
WorkingDirectory=/home/labadmin/mcp-lab/mcp-server
EnvironmentFile=-/home/labadmin/mcp-lab/mcp-server/mcp-server.env
ExecStart=/home/labadmin/mcp-lab/mcp-server/venv/bin/python3 mcp_server.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
