# Template — __INSTALL_USER__/__INSTALL_HOME__ are substituted by
# setup-mcphost.sh at install time (sed, before copying to
# /etc/systemd/system/). Don't `cp` this file directly; run the script.
[Unit]
Description=MCP Server (mcp-lab)
After=network.target ollama.service
Wants=ollama.service

[Service]
Type=simple
User=__INSTALL_USER__
WorkingDirectory=__INSTALL_HOME__/mcp-lab/mcp-server
EnvironmentFile=-__INSTALL_HOME__/mcp-lab/mcp-server/mcp-server.env
ExecStart=__INSTALL_HOME__/mcp-lab/mcp-server/venv/bin/python3 mcp_server.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
