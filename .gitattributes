# Always use LF line endings on all platforms
* text=auto eol=lf

# Explicitly mark shell scripts as LF
*.sh text eol=lf

# Explicitly mark Python files as LF
*.py text eol=lf

# Service units — LF
*.service text eol=lf

# Env files — LF
*.env text eol=lf
*.env.example text eol=lf

# Binary files — no line ending conversion
*.png binary
*.jpg binary
*.zip binary
